# Copy this file to config.env and fill it in. Both scripts read config.env
# from their own folder. Values already set in the shell environment win.

# Production Elasticsearch endpoint (not Kibana), no trailing slash.
ES_URL=https://<deployment>.es.<region>.<provider>.elastic-cloud.com

# The "encoded" value of the API key from README step 2. Keep this file private.
ES_API_KEY=

# Index patterns that hold process-start events (comma separated, no spaces).
# Only lolbas_ml.py reads this. The rule and query files list the patterns themselves.
INDEX_PATTERNS=logs-endpoint.events.process-*,logs-crowdstrike.fdr-*,logs-m365_defender.event-*

# Where the ML datafeed starts reading the first time it is created.
ML_START=now-1d

# Memory limit for the ML job. Raise it if the job reports hard_limit.
ML_MEMORY_LIMIT=512mb
