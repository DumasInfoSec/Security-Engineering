DeviceProcessEvents
| where FileName =~ "bitsadmin.exe"
// Download: /transfer from a URL. Persistence: /SetNotifyCmdLine runs a command when the job finishes.
| where ProcessCommandLine has_all ("/transfer", "http") or ProcessCommandLine has "SetNotifyCmdLine"
| project Timestamp, DeviceId, DeviceName, ReportId, AccountName, ProcessCommandLine, InitiatingProcessFileName

///Many software updates (Chrome, Adobe, etc.) use BITS. Filter out these legitimate installers by their InitiatingProcessParentFileName.
